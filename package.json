{
  "name": "pi-research-loop",
  "version": "0.1.0",
  "description": "An evidence-first research loop for Pi and Claude Code",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "claude-code-plugin",
    "research",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build:claude": "tsc -p tsconfig.claude.json && node scripts/build-claude.mjs",
    "check": "tsc --noEmit",
    "check:claude": "npm run build:claude && claude plugin validate --strict .",
    "statusline:install": "npm run build:claude && node dist/claude/statusline-cli.js install",
    "statusline:status": "node dist/claude/statusline-cli.js status",
    "statusline:uninstall": "node dist/claude/statusline-cli.js uninstall",
    "test:claude": "npm run build:claude && node tests/core-smoke.mjs && node tests/hook-smoke.mjs && node tests/mcp-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.12.0",
    "esbuild": "^0.25.12",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
